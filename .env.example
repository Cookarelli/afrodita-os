# Public Supabase configuration. The anon key is safe for browser use only when
# all tables and storage buckets have correct row-level policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public reservation requests expire after this many hours unless staff extends
# or confirms them. Supported range: 1-168.
RESERVATION_EXPIRATION_HOURS=24

# Stripe placeholders only. Do not paste secrets into source files or logs.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=acct_1LJhcKFiGarP8tu7

# Canonical URLs used for auth redirects and webhook documentation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
